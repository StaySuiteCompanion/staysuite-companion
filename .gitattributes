# Development-only paths. GitHub's source zip and `git archive` skip these,
# so a repo clone is small and a release artifact can never pick them up by
# accident. bin/build.sh keeps its own allowlist as the source of truth.
.gitattributes export-ignore
.gitignore export-ignore
/bin export-ignore
/docs export-ignore
/CHANGELOG.d export-ignore
/src export-ignore
/dist export-ignore
/node_modules export-ignore
/vendor export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/webpack.config.js export-ignore
/phpcs.xml export-ignore
/README.md export-ignore
*.map export-ignore
*.scss export-ignore